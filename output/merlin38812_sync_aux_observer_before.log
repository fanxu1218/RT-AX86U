SYNC_DIAGNOSTIC /tmp/owned-sync-user
user
SYNC_DIAGNOSTIC /koolshare/bin/ks-unmount.sh
#!/bin/sh

# localmod-event-dedup
if [ -n "$LOCALMOD_EVENT_DIR" ]; then
 case "$LOCALMOD_EVENT_DIR" in /tmp/.localmod/event.*) ;; *) exit 1;; esac
 mkdir "$LOCALMOD_EVENT_DIR/ks-unmount.sh" 2>/dev/null || exit 0
fi


source /koolshare/scripts/base.sh

KSPATH=$1

[ $# -lt 1 ] && exit 1

for i in $(find /koolshare/init.d/ -name 'U*' | sort -n);
do
	case "$i" in
		U* | *.sh )
			# fork subprocess.
			trap "" INT QUIT TSTP EXIT
			if [ -r "$i" ]; then
				_LOG "[软件中心]-[${0##*/}]: $i $KSPATH"
				"$i" "$KSPATH"
			fi
			;;
		*)
			# No sh extension, Source shell script for speed.
			_LOG "[软件中心]-[${0##*/}]: . $i $KSPATH"
			. $i $KSPATH
			;;
	esac
done

